# Hostinger LiteSpeed / Apache Web Server Configuration
# Hajji Original Tours Admin Management System

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not rewrite existing static files, directories, uploads, or assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Prevent API requests from being rewritten to index.html
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

  # 3. Single Page Application (SPA) route fallback
  RewriteCond %{REQUEST_URI} !^/api
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^ dist/index.html [L]

  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
</IfModule>
